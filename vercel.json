{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|pwa-.*\\.png|apple-touch-icon\\.png|icon\\.svg|vite\\.svg|sw\\.js|workbox-.*\\.js|robots\\.txt|llms\\.txt|manifest\\.webmanifest).*)",
      "destination": "/index.html"
    }
  ]
}
